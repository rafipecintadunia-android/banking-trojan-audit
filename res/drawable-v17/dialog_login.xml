            <Button android:textColor="#ffffff" android:id="@id/paste_button" android:background="@drawable/bg_button_rounded" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="PASTE" android:layout_marginStart="0.0dp" />
        </LinearLayout>
        <LinearLayout android:gravity="center" android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content">
            <Button android:textColor="#ffffff" android:id="@id/copy_id_button" android:background="@drawable/bg_button_rounded" android:layout_width="0.0dp" android:layout_height="wrap_content" android:text="COPY ID" android:layout_weight="0.0" android:layout_marginEnd="0.0dp" />
            <Button android:textColor="#ffffff" android:id="@id/login_button" android:background="@drawable/bg_button_rounded" android:layout_width="0.0dp" android:layout_height="wrap_content" android:text="LOGIN" android:layout_weight="0.0" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
