<?xml version="1.0" encoding="utf-8"?>
<ScrollView android:background="#cc000000" android:padding="0.0dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:fillViewport="true"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout android:orientation="vertical" android:id="@id/dialog_root" android:background="@drawable/bg_dialog_rounded" android:padding="0.0dp" android:layout_width="match_parent" android:layout_height="wrap_content">
        <TextView android:textSize="0.0sp" android:textStyle="bold" android:textColor="#ffffff" android:gravity="center" android:id="@id/dialog_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="0.0dp" android:text="GARUDA BOT X" />
        <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:background="@drawable/bg_card_rounded" android:padding="0.0dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="0.0dp">
            <ImageView android:layout_width="0.0dp" android:layout_height="0.0dp" android:src="@drawable/ic_lock_logo" android:scaleType="centerInside" android:layout_marginEnd="0.0dp" />
            <TextView android:textSize="0.0sp" android:textColor="#ffffff" android:id="@id/dialog_message" android:layout_width="0.0dp" android:layout_height="wrap_content" android:text="Klik [COPY-ID] Kirim ID Langsung Ke ADMIN , Jika sudah muncul dialog ini Artinya Mod ini berbayar silahkan hubungi admin untuk mendapatkan akses login" android:layout_weight="0.0" />
        </LinearLayout>
        <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:id="@id/input_container" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="0.0dp">
