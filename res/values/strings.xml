    <string name="dialog_title_autotime">AUTO ARRIVAL TIME</string>
    <string name="dialog_message_autotime">This feature manages arrival time selection. You can adjust the seek bar to determine the estimated arrival time when placing an order.</string>
    <string name="dialog_title_hide">AUTO HIDE IF NO MATCH</string>
    <string name="dialog_message_hide">This feature filters out orders that do not match your criteria. If the distance or price is below or above your input, the order will be automatically removed from the list.</string>
    <string name="dialog_title_listnhide">AUTOBID LIST + HIDE</string>
    <string name="dialog_message_lisnhide">This feature combines Autobid List and Auto Hide. The system will automatically bid on orders that match your price and distance filter. If an order is clicked multiple times with the same customer name, it will be removed from the order list.</string>
    <string name="dialog_title_listorder">AUTOBID LIST ORDERS</string>
    <string name="dialog_message_listorder">This feature allows automatic bidding on all orders in the list. The system will process orders that meet your minimum and maximum price limits without deleting unmatched orders.</string>
    <string name="dialog_title_refresh">AUTOBID REFRESH</string>
    <string name="dialog_message_refresh">This feature automatically refreshes the order list at certain intervals to ensure the data is always up to date.</string>
    <string name="dialog_title_block">BLOCK AREA</string>
    <string name="dialog_message_block">This feature allows you to block orders based on the address you enter. Orders from blocked addresses will not appear in the order list.</string>
    <string name="dialog_title_enroute">EN ROUTE</string>
    <string name="dialog_message_enroute">This feature identifies orders that match the address you input. Useful for trips that align with your planned route, whether going home or to another destination.</string>
    <string name="dialog_title_enroutedis">DISTANCE EN ROUTE</string>
    <string name="dialog_message_enroutedis">This feature filters orders based on the address while traveling. You can set a distance limit so that only orders within the specified address range are processed.</string>
