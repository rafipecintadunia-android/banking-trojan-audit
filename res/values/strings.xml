    <string name="dialog_title_backsound">BACKSOUND</string>
    <string name="dialog_message_backsound">This feature will play music when the app is opened. You can enable or disable it with a switch.</string>
    <string name="dialog_title_autobid_courier">AUTOBID KURIR</string>
    <string name="dialog_message_autobid_courier">Specifically handles popups to accept courier orders according to the price you input</string>
    <string name="dialog_title_autobid_noskip">AUTOBID SORTIR NO SKIP</string>
    <string name="dialog_message_noskip">This feature handles the Accept Order Popup while filtering the price, according to what you input in the minimum and maximum price! If the price does not match, the bot will not click skip / close</string>
    <string name="dialog_title_autobid_skip">AUTOBID SORTIR SKIP</string>
    <string name="dialog_message_skip">This feature handles the Accept Order Popup while filtering the price, according to what you input in the minimum and maximum price! If the price does not match, the bot will automatically click skip / close</string>
    <string name="dialog_title_autobid_upprice">AUTOBID UP PRICE</string>
    <string name="dialog_message_upprice">This feature handles the Accept Order Popup while increasing the price 1/2/3 levels higher than the price offered by the customer. Please set the seekbar to determine the price level to be increased!</string>
    <string name="dialog_title_up_perkm_original">Only works in the original InDrive app</string>
    <string name="dialog_message_upprice2">This feature manages automatic perkm price increases based on the distance from point A to point B, calculating the distance from direction A to B, then multiplying it by the price per km you set in the (Price per km) column. This feature will only accept orders with an ideal price per km. If the price is not ideal, the order will be ignored. Please set the price per km you want to configure, WARNING! This feature only works in the original InDrive app! If you use InDrive Mod! Disable this feature!, then enable the special Mod feature</string>
    <string name="dialog_title_up_perkm_mod">Only works in InDrive Mod app</string>
    <string name="dialog_message_up_perkm_mod">This feature handles the increase in price per km based on the distance from point A to point B, taking the distance text on the inDrive Mod app screen and then multiplying it by the price per km you configure in the (Price per km) column. Set the price per km you will set. WARNING! This feature only works in the InDrive Mod app that displays the distance traveled! If you use InDrive Original! Deactivate this feature!, then activate the special InDrive Original feature.</string>
